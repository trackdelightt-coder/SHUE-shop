rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 商品：所有人都能看（買家頁面要顯示），
    // 新增/刪除/大部分修改都要先登入（Firebase Authentication）才能做，
    // 但「只改庫存、而且庫存只能變少」這個特例開放給沒登入的買家，
    // 這樣買家送出訂單時系統才能自動扣庫存。
    match /items/{itemId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
          request.resource.data.stock is int &&
          request.resource.data.stock >= 0 &&
          request.resource.data.stock <= resource.data.stock
        );
    }

    // 訂單：任何人都可以「新增」一筆訂單（買家送出訂單），
    // 但只有登入的管理員可以「讀取列表」和「修改狀態」，買家看不到別人的訂單內容。
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 商店設定（公告）：所有人都能看，只有登入的管理員能改。
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 競標商品：所有人都能看。新增/刪除、以及大部分修改都要登入才能做，
    // 但「買家出價」這個特例開放給沒登入的買家（跟商品扣庫存是一樣的精神）：
    // 只能改「目前價格／目前得標人／出價次數」這幾個欄位，而且：
    // - 競標時間還沒到（沒被下架）才能出價
    // - 新的價格一定要「剛好」等於目前價格加一個固定的加價金額（不能亂填數字）
    // - 出價次數一定要剛好+1
    // - 得標人暱稱要有填、長度合理
    // 這樣就算是完全陌生的訪客也不能亂改標題、圖片、起標價、加價金額、結標時間等其他欄位。
    match /auctions/{auctionId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null
        || (
          resource.data.active != false &&
          request.time < resource.data.endTime &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentPrice', 'currentBidderName', 'currentBidderContact', 'bidCount']) &&
          request.resource.data.currentPrice is number &&
          request.resource.data.currentPrice == resource.data.currentPrice + resource.data.bidIncrement &&
          request.resource.data.bidCount == resource.data.bidCount + 1 &&
          request.resource.data.currentBidderName is string &&
          request.resource.data.currentBidderName.size() > 0 &&
          request.resource.data.currentBidderName.size() < 60 &&
          request.resource.data.currentBidderContact is string &&
          request.resource.data.currentBidderContact.size() < 200
        );
    }

    // 出價紀錄：所有人都能看（方便對照歷史出價），任何人都能「新增」一筆出價紀錄
    // （買家出價時順便留一筆記錄），但只有登入的管理員能修改或刪除既有紀錄。
    match /auctionBids/{bidId} {
      allow read: if true;
      allow create: if request.auth != null
        || (
          request.resource.data.keys().hasOnly(['auctionId', 'bidderName', 'bidderContact', 'amount', 'createdAt']) &&
          request.resource.data.auctionId is string &&
          request.resource.data.bidderName is string &&
          request.resource.data.bidderName.size() > 0 &&
          request.resource.data.amount is number
        );
      allow update, delete: if request.auth != null;
    }
  }
}
